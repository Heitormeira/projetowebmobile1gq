# Copie este arquivo para ".env.local" e preencha com as credenciais do seu app no Back4App:
# Dashboard Back4App > App Settings > Security & Encryption
NEXT_PUBLIC_BACK4APP_APP_ID=SEU_APPLICATION_ID_AQUI
NEXT_PUBLIC_BACK4APP_JAVASCRIPT_KEY=SUA_JAVASCRIPT_KEY_AQUI

# Senha do administrador (só quem tem ela consegue excluir cadastros). Escolha uma senha longa.
ADMIN_SENHA=troque-por-uma-senha-forte
